# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Local: mongodb://localhost:27017/velos_iam
# Docker compose: mongodb://mongo:27017/velos_iam
MONGO_URI=mongodb://localhost:27017/velos_iam

# --- Auth ---
# Use a long, random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# --- Email / OTP (SMTP) ---
# In non-production, OTPs are logged to the console and SMTP is optional.
# In production these are required for OTP email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Velos IAM <no-reply@velos.local>"
