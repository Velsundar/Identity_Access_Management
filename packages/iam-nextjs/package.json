{
  "name": "@velos/iam-nextjs",
  "version": "0.0.0",
  "description": "Next.js integration for Velos IAM: middleware, server helpers and re-exported React bindings",
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "dependencies": {
    "@velos/iam-core": "workspace:*",
    "@velos/iam-react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.8.2"
  }
}
